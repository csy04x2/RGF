
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <title>RGF Reporting Brief</title>
    <style>
        body {
            font-family: system-ui;
            max-width: 1100px;
            margin: auto;
            padding: 2rem;
            line-height: 1.6;
        }

        article {
            border: 1px solid #ddd;
            padding: 1rem;
            margin: 1rem 0;
        }

        pre {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .review-warning {
            border: 1px solid #d69e2e;
            border-left: 5px solid #d69e2e;
            background: #fffaf0;
            padding: 1rem;
            margin: 1.5rem 0;
        }

        .review-warning li {
            margin-bottom: 0.5rem;
        
.relation-review {
    border: 1px solid #ddd;
    padding: 1.25rem;
    margin: 1.5rem 0;
    border-radius: 8px;
}

.relation-review article {
    border-left: 5px solid #d69e2e;
    background: #fffaf0;
    border-radius: 4px;
}

.relation-review article.unrelated {
    border-left-color: #c53030;
    background: #fff5f5;
}

.relation-review article.questionable {
    border-left-color: #d69e2e;
}

.relation-review .review-meta {
    font-weight: 600;
    margin-bottom: 0.5rem;
}

    </style>
</head>

<body>
    <h1>RGF Reporting Brief</h1>

    {% if warnings %}
    <section class="review-warning">
        <h2>정책 시행 상태 검토 필요</h2>

        <p>
            {{ warnings|length }}개의 검토 항목이 발견되었습니다.
            아래 내용은 자동 판정이 아닌 기자 확인 대상입니다.
        </p>

        <ul>
            {% for warning in warnings %}
            <li>{{ warning }}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    <p>{{ a.discovery_summary }}</p>
    
{% if relation_reviews %}
<section class="relation-review">
    <h2>AI 관계 검토 결과</h2>

    <p>
        총 {{ relation_reviews|length }}개 연결 관계를 검토했습니다.
        이 결과는 AI의 검토 의견이며 최종 판정은 기자가 수행합니다.
    </p>

    {% for review in relation_reviews %}
        {% if review.verdict != "SUPPORTED" %}
        <article class="{{ review.verdict|lower }}">
            <h3>
                {{ review.lead_id }} →
                {{ review.target_id }}
            </h3>

            <p class="review-meta">
                판정: {{ review.verdict }}
            </p>

            <p>
                <strong>검토 이유:</strong>
                {{ review.reason }}
            </p>

            <p>
                <strong>제안 조치:</strong>
                {{ review.suggested_action }}
            </p>
        </article>
        {% endif %}
    {% endfor %}
</section>
{% endif %}


    {% for cname in collections %}
    <section>
        <h2>{{ cname }}</h2>

        {% for o in a|attr(cname) %}
        <article
            data-collection="{{ cname }}"
            data-object-id="{{ object_id(o) }}"
        >
            <h3>{{ object_id(o) }}</h3>
            <pre>{{ o.model_dump_json(indent=2) }}</pre>
        </article>
        {% endfor %}
    </section>
    {% endfor %}
</body>
</html>
