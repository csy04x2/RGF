<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>RGF Reporting Brief</title><style>body{font-family:system-ui;max-width:1100px;margin:auto;padding:2rem}article{border:1px solid #ddd;padding:1rem;margin:1rem 0}pre{white-space:pre-wrap}</style></head><body><h1>RGF Reporting Brief</h1><p>{{ a.discovery_summary }}</p>{% for cname in collections %}<section><h2>{{ cname }}</h2>{% for o in a|attr(cname) %}<article data-collection="{{ cname }}" data-object-id="{{ object_id(o) }}"><h3>{{ object_id(o) }}</h3><pre>{{ o.model_dump_json(indent=2) }}</pre></article>{% endfor %}</section>{% endfor %}</body></html>
