{% macro idea_management(idea) %}
<details class="run-actions"><summary role="button" aria-label="아이디어 {{ idea.lead_id }} 관리">⋯</summary>
<div class="management-menu">
<details><summary>이름 변경</summary><form method="post" action="/ideas/{{ idea.id }}/rename"><label>아이디어 제목<input name="title" value="{{ idea.title }}" required maxlength="500"></label><button type="submit">이름 저장</button></form></details>
<form method="post" action="/ideas/{{ idea.id }}/delete" onsubmit="return confirm('이 아이디어를 삭제하시겠습니까? 연결된 기자 검토 기록과 원문 근거 링크가 작업 목록에서 사라집니다. 원본 AI 분석 JSON과 다른 아이디어는 유지됩니다.');"><button type="submit" name="confirmed" value="yes">삭제</button></form>
</div></details>
{% endmacro %}
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>분석 개요 | RGF</title><style>
    :root{font-family:system-ui,-apple-system,"Malgun Gothic",sans-serif;color:#2b2521;background:#f7f1eb;font-synthesis:none}
    *{box-sizing:border-box} body{margin:0} button,input,select,textarea{font:inherit} a{color:inherit;text-decoration:none}
    button{cursor:pointer} button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #f6a168;outline-offset:2px}
    .shell{display:grid;grid-template-columns:244px minmax(0,1fr);min-height:100vh}
    .sidebar{background:#fffcf9;border-right:1px solid #e7dcd3;padding:25px 18px;display:flex;flex-direction:column;gap:28px}
    .brand{display:flex;align-items:center;gap:12px;font-size:26px;font-weight:850;letter-spacing:-1px}
    .logo{display:grid;place-items:center;width:42px;height:42px;background:#e76929;color:white;border-radius:11px;font-weight:850}
    .brand small{display:block;font-size:9px;font-weight:700;letter-spacing:1.1px;color:#8c796b}
    .new{background:#e76b2b;color:#fff;text-align:center;padding:13px 10px;border-radius:9px;font-weight:750}
    .nav-title,.eyebrow{font-size:10px;font-weight:850;letter-spacing:1.6px;color:#b75b2f}
    .nav-title{color:#8f7e74;margin:0 10px 10px}
    .nav a{display:block;padding:11px 13px;border-radius:9px;font-size:14px;margin-bottom:3px}
    .nav a.current{background:#fbe8db;color:#b7501b;font-weight:750}
    .muted{color:#82746a}.sidebar-foot{font-size:12px;color:#9b8879;margin-top:auto;border-top:1px solid #eadfd7;padding-top:18px}
    main{padding:30px clamp(18px,3vw,52px) 60px;min-width:0}
    .back{font-size:13px;color:#817166}.top h1{font-size:clamp(24px,2.6vw,34px);letter-spacing:-1.4px;margin:11px 0 7px}
    .meta{font-size:13px;color:#87766b}.page-tabs{border-bottom:1px solid #e4d8cd;display:flex;gap:26px;margin:29px 0 20px;padding-bottom:12px;flex-wrap:wrap}
    .page-tabs a{font-size:14px;padding:0 0 12px}.page-tabs a.current{font-weight:800;color:#c45419;border-bottom:3px solid #e76b2b;margin-bottom:-15px}
    .workspace{display:grid;grid-template-columns:minmax(265px,.84fr) minmax(0,1.36fr);gap:16px;align-items:start}
    .panel{background:#fff;border:1px solid #eee1d6;border-radius:14px;box-shadow:0 3px 12px #5c352509;padding:20px;min-width:0}
    .panel h2{font-size:20px;letter-spacing:-.7px;margin:0 0 6px}.subtitle{font-size:13px;color:#82746a;margin:0 0 19px}
    .filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
    .filter{border:1px solid #e6dacf;border-radius:7px;background:#fff;padding:8px 11px;font-size:12px;color:#514137}
    .filter.active{background:#e76b2b;color:white;border-color:#e76b2b}
    .idea-list{max-height:68vh;overflow:auto;padding-right:3px}.idea-button{width:100%;text-align:left;border:0;border-bottom:1px solid #eee2da;background:#fff;display:flex;align-items:start;gap:10px;padding:14px 9px;border-radius:7px;color:#332923}
    .idea-button[aria-selected="true"]{background:#fcebe0}.id-chip{font-size:12px;color:#b75b2f;background:#fff4ed;border-radius:6px;padding:5px 7px;font-weight:800;flex-shrink:0}
    .idea-text{flex:1;min-width:0}.idea-text strong{display:block;font-size:13px;line-height:1.5}.idea-text span{display:block;color:#88766c;font-size:11px;margin-top:3px}
    .status{font-size:11px;background:#f5f1ec;border-radius:999px;padding:5px 9px;color:#736255;white-space:nowrap}
    .detail[hidden],.idea-button[hidden]{display:none!important}
    .detail-head{display:flex;gap:13px;align-items:flex-start}.detail-head .id-chip{font-size:16px;color:white;background:#e76b2b;padding:10px}
    .detail-head h2{font-size:clamp(19px,2vw,25px);line-height:1.35;margin:5px 0 9px}
    .detail-head .status{margin-left:auto}.summary{font-size:14px;line-height:1.8;color:#6d5d53;margin:17px 0 23px}
    .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.info-card{border:1px solid #eadbd0;border-radius:10px;padding:17px;background:#fffdfb}
    .info-card h3{color:#b9541e;font-size:14px;margin:0 0 11px}.info-card p{font-size:13px;line-height:1.8;margin:0;overflow-wrap:anywhere}
    .info-card ul{padding-left:19px;margin:0;font-size:13px;line-height:1.8}.info-card li+li{margin-top:7px}
    .evidence{margin-top:15px;background:#fcf1e8;border-radius:10px;padding:17px}.evidence h3{color:#a64d20;font-size:14px;margin:0 0 12px}
    .quote{background:#fff9f4;border:1px solid #eddfd4;padding:12px;border-radius:7px;margin-top:10px;font-size:13px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}
    .quote small{display:block;color:#927e71;margin:0 0 6px}.warning{font-size:12px;color:#8d5d43;line-height:1.7;margin:12px 0 0}
    .review-form{margin-top:18px;border-top:1px solid #ebdfd5;padding-top:20px}.review-form h3{font-size:17px;margin:0 0 15px}
    .fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.review-form label{font-size:13px;font-weight:650;display:block;margin-bottom:12px}
    .review-form input,.review-form select,.review-form textarea{display:block;width:100%;border:1px solid #ddcec2;border-radius:7px;background:#fff;padding:10px;margin-top:7px;font-weight:400;color:#29221e}
    .review-form textarea{min-height:88px;resize:vertical}.save{background:#e76b2b;color:white;border:0;border-radius:7px;padding:11px 20px;font-weight:750}
    .empty{padding:35px 10px;color:#807269;font-size:14px;line-height:1.7}.help{font-size:12px;color:#8f7d72}
    @media(max-width:1080px){.shell{grid-template-columns:200px minmax(0,1fr)}.workspace{grid-template-columns:1fr}.idea-list{max-height:290px}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:650px){.shell{display:block}.sidebar{padding:12px 16px;gap:12px}.sidebar .nav,.sidebar-foot{display:none}.brand{font-size:21px}.new{padding:9px}.top h1{font-size:24px}main{padding:20px 14px}.page-tabs{gap:15px}.cards,.fields{grid-template-columns:1fr}.detail-head{flex-wrap:wrap}}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}.stat{background:white;border:1px solid #eee1d6;border-radius:12px;padding:22px}.stat strong{display:block;font-size:30px;margin:10px 0}.overview-section{margin-bottom:18px}.overview-list{display:grid;gap:11px}.overview-item{border:1px solid #eadbd0;border-radius:9px;padding:15px;background:#fffdfb}.overview-item h3{font-size:15px;margin:5px 0}.overview-item p{font-size:13px;color:#65564d;line-height:1.8;white-space:pre-wrap;margin:8px 0 0}@media(max-width:780px){.stats{grid-template-columns:1fr}}
    .sidebar{gap:20px;position:sticky;top:0;height:100vh;overflow-y:auto}
    .sidebar .nav a{font-size:13px}
    .lead-group{margin:0 0 8px}
    .lead-group>summary{cursor:pointer;list-style:none;padding:11px 13px;border-radius:9px;font-size:14px;font-weight:750;color:#b7501b;background:#fbe8db;display:flex;gap:8px;align-items:center}
    .lead-group>summary::-webkit-details-marker{display:none}
    .lead-group>summary::before{content:'▸';font-size:13px}
    .lead-group[open]>summary::before{content:'▾'}
    .lead-count{margin-left:auto;font-size:12px;color:#9a654a}
    .lead-menu{margin:8px 0 0 9px;padding-left:9px;border-left:1px solid #eadbd0;display:grid;gap:3px}
    .nav .lead-menu a{display:block;margin:0;padding:9px 8px;font-size:12px;line-height:1.45;overflow-wrap:anywhere}
    .nav .lead-menu a.selected{background:#fcebe0;color:#9f4116;font-weight:700}
    .lead-label{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .lead-status{font-size:10px;color:#8e7b6e;margin-left:5px}
    .lead-status.hold{color:#ae5a25}
    .workspace{display:block}
    .workspace>.panel{width:100%;max-width:1100px}
    @media(max-width:650px){.sidebar{position:static;height:auto;max-height:46vh;overflow-y:auto}.sidebar .nav{display:block}.sidebar-foot{display:none}.lead-menu{max-height:220px;overflow:auto}}

    /* Resizable left navigation and properly wrapping reporting-lead titles. */
    .shell{grid-template-columns:minmax(0,var(--rgf-sidebar-width,300px)) 7px minmax(0,1fr)}
    .sidebar{min-width:0;overflow-x:hidden}
    .nav,.lead-group,.lead-menu,.lead-link{min-width:0;max-width:100%}
    .lead-label{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere;word-break:keep-all;line-height:1.5}
    .nav .lead-menu a{white-space:normal;overflow-wrap:anywhere}
    .sidebar-resizer{cursor:col-resize;touch-action:none;background:#ede3d9;position:relative}
    .sidebar-resizer::after{content:"";position:absolute;top:45%;left:2px;width:3px;height:38px;background:#c7b6a7;border-radius:4px}
    .sidebar-resizer:hover,.sidebar-resizer:focus-visible{background:#e7b392;outline:none}
    body.sidebar-dragging{cursor:col-resize;user-select:none}
    @media(max-width:650px){.shell{display:block}.sidebar-resizer{display:none}}
    .overview-item h3{white-space:pre-wrap;overflow-wrap:anywhere}
    .saved-run{display:flex;align-items:flex-start;gap:4px;min-width:0}.saved-run>.analysis-link{flex:1;min-width:0}
    .run-actions{flex:0 0 auto}.run-actions>summary{cursor:pointer;padding:9px;list-style:none}.run-actions>summary::-webkit-details-marker{display:none}
    .run-actions[open]{flex:1;min-width:0}.run-actions form{padding:8px 0;font-size:12px}.run-actions input{width:100%;min-width:0;margin:6px 0}.run-actions button{font:inherit;margin:4px 0}.run-actions small{display:block;line-height:1.5;color:#82746a}
    .managed-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:4px;position:relative;min-width:0;border-radius:8px;padding:4px}
    .managed-row>a,.managed-row>.idea-button{flex:1;min-width:0;margin:0;background:transparent;border:0}
    .managed-row:hover,.managed-row:focus-within{background:#f3e1d3}
    .managed-row:has(>a.selected),.managed-row:has(>.idea-button[aria-pressed="true"]){background:#fcebe0;box-shadow:inset 3px 0 #c45419}
    .managed-row[hidden]{display:none!important}
    .managed-row>.run-actions{flex:0 0 36px}
    .managed-row>.run-actions>summary{opacity:0;cursor:pointer;list-style:none;padding:8px;text-align:center;border-radius:6px}
    .managed-row:hover>.run-actions>summary,.managed-row:focus-within>.run-actions>summary,.managed-row>.run-actions[open]>summary{opacity:1}
    .managed-row>.run-actions[open]{flex:0 0 100%}
    .managed-row>.run-actions[open]>summary{position:absolute;right:4px;top:4px}
    .managed-row:has(>.run-actions[open])>:first-child{margin-right:40px;flex-basis:calc(100% - 44px)}
    .management-menu{background:#fffdfb;border:1px solid #ddcec2;border-radius:8px;padding:8px;margin-top:4px;box-shadow:0 3px 10px #5c352515;font-size:13px}
    .management-menu>details>summary{cursor:pointer;padding:8px}
    .management-menu form{padding:4px 8px;margin:0}.management-menu input{width:100%;margin:6px 0;min-width:0}.management-menu button{font:inherit;padding:6px 8px}.management-menu small{display:block;line-height:1.5;color:#82746a}
    @media(hover:none),(pointer:coarse),(max-width:650px){.managed-row>.run-actions>summary{opacity:1}}
</style></head><body><div class="shell">
<aside class="sidebar" aria-label="기본 탐색">
<div class="brand"><span class="logo">R</span><div>RGF<small>REPORTING GAP FINDER</small></div></div>
<a href="/" class="new">＋ 새 자료 분석</a>
<nav class="nav" aria-label="작업 메뉴"><p class="nav-title">WORKSPACE</p>
<details class="lead-group" open>
<summary>보도자료</summary>
<div class="lead-menu" aria-label="저장된 완료 분석">
{% for saved in completed_analyses %}
<div class="saved-run managed-row">
<a class="analysis-link{{ ' selected' if saved.run_id == run_id else '' }}" href="/workspace/{{ saved.run_id }}"{% if saved.run_id == run_id %} aria-current="true"{% endif %}>
<span class="lead-label">{{ saved.title }}</span>
<span class="lead-status">분석 #{{ saved.run_id }} · {{ saved.completed_at.strftime('%Y.%m.%d') if saved.completed_at else '완료일 미확인' }}</span>
</a>
<details class="run-actions"><summary role="button" aria-label="분석 #{{ saved.run_id }} 관리">⋯</summary>
<div class="management-menu"><details><summary>이름 변경</summary>
<form method="post" action="/analysis-runs/{{ saved.run_id }}/rename">
<label>이름 변경<input name="title" value="{{ saved.title }}" required maxlength="500" aria-label="보도자료 제목"></label>
<small>같은 보도자료의 모든 분석에 제목 변경이 적용됩니다.</small><button type="submit">이름 저장</button>
</form></details>
<form method="post" action="/analysis-runs/{{ saved.run_id }}/delete" onsubmit="return confirm('분석 #{{ saved.run_id }}을 삭제하시겠습니까? 연결된 취재 아이디어와 기자 검토 기록도 삭제됩니다. 다른 분석과 PDF 파일은 유지됩니다.');">
<button type="submit" name="confirmed" value="yes">삭제</button>
</form></div></details></div>
{% else %}<span class="muted">완료된 분석이 없습니다.</span>{% endfor %}
</div></details>
<a class="current" aria-current="page" href="/workspace/{{ run_id }}">▦ 분석 개요</a>
<details class="lead-group" open><summary>◉ 취재 아이디어 <span class="lead-count">{{ nav_ideas|length }}</span></summary>
<div class="lead-menu" aria-label="추가 취재 과제">
{% for idea in nav_ideas %}
<div class="managed-row"><a href="/review?run_id={{ run_id }}&amp;lead={{ idea.lead_id|urlencode }}"><span class="lead-label">{{ idea.title }}</span><span class="lead-status{{ ' hold' if idea.review_status == '보류' else '' }}">{{ idea.review_status }}</span></a>{{ idea_management(idea) }}</div>
{% else %}<span class="muted">등록된 취재 아이디어 없음</span>{% endfor %}
</div></details></nav><div class="sidebar-foot">RGF v0.1<br>AI 분석 결과는 취재 제안이며 최종 판단은 기자가 수행합니다.</div></aside>
  <div class="sidebar-resizer" role="separator" aria-label="사이드바 너비 조절" aria-orientation="vertical" aria-valuemin="220" aria-valuemax="520" aria-valuenow="300" tabindex="0" title="좌우로 드래그하여 사이드바 너비 조절"></div>

<main><header class="top"><a href="/" class="back">← 새 자료 분석</a>
<div class="eyebrow" style="margin-top:18px">ANALYSIS OVERVIEW</div>
<h1>{{ source.title }}</h1><div class="meta">{{ source.organization or '발표 기관 미입력' }} · 분석 #{{ run_id }} · 저장일 {{ source.completed_at.strftime('%Y.%m.%d') if source.completed_at else '미확인' }}</div></header>

<section class="stats" aria-label="분석 요약 수치"><div class="stat"><div class="eyebrow">REPORTING LEADS</div><strong>{{ idea_count }}</strong><span class="muted">취재 아이디어</span></div><div class="stat"><div class="eyebrow">SOURCE GAPS</div><strong>{{ gaps|length }}</strong><span class="muted">자료 내 정보 공백</span></div><div class="stat"><div class="eyebrow">MATERIAL CHANGES</div><strong>{{ changes|length }}</strong><span class="muted">주요 정책 변화</span></div></section>
<section class="panel overview-section"><div class="eyebrow">DISCOVERY SUMMARY</div><h2 style="margin-top:8px">핵심 분석 요약</h2><p style="font-size:14px;line-height:1.85;white-space:pre-wrap">{{ analysis.discovery_summary }}</p></section>
<section class="panel overview-section"><div class="eyebrow">POLICY CHANGES</div><h2 style="margin:8px 0 15px">주요 정책 변화</h2><div class="overview-list">
{% for change in changes %}<article class="overview-item"><div class="eyebrow">{{ change.id }} · {{ change.implementation_status }}</div><h3>{{ change.change }}</h3><p>이전: {{ change.before }}
이후: {{ change.after }}</p>{% if change.unknown %}<p>추가 확인: {{ change.unknown }}</p>{% endif %}</article>{% else %}<p class="muted">분석된 정책 변화가 없습니다.</p>{% endfor %}
</div></section>
<section class="panel overview-section"><div class="eyebrow">SOURCE GAPS</div><h2 style="margin:8px 0 8px">원문에서 발견한 정보 공백</h2><p class="subtitle">저장된 자료 구조화 결과입니다. 외부 취재를 통해 검증된 사실은 아닙니다.</p><div class="overview-list">
{% for gap in gaps %}<article class="overview-item"><div class="eyebrow">{{ gap.id }} · {{ gap.gap_type.value }}</div><h3>{{ gap.missing_information }}</h3><p>{{ gap.why_it_matters }}</p></article>{% else %}<p class="muted">저장된 정보 공백이 없습니다.</p>{% endfor %}
</div></section><details class="panel overview-section" style="padding:15px 20px"><summary style="cursor:pointer;font-weight:700;color:#a64d20">AI 전체 분석 결과 보기</summary>
<p class="help">선택하면 기존 전체 분석 화면을 열 수 있습니다. 저장된 분석 데이터는 삭제되지 않았습니다.</p>
<a href="/analysis/{{ run_id }}" style="color:#b7501b;text-decoration:underline">전체 분석 화면 열기</a></details>
<p class="help">AI 분석은 취재 출발점이며 최종 사실 판단은 기자가 수행합니다.</p>
</main></div>
<script>
(function(){
  const shell=document.querySelector('.shell');
  const handle=document.querySelector('.sidebar-resizer');
  if(!shell||!handle)return;
  function bounds(){return {min:220,max:Math.max(220,Math.min(520,window.innerWidth-330))};}
  function setWidth(px){
    const {min,max}=bounds();
    const value=Math.min(max,Math.max(min,Math.round(px)));
    shell.style.setProperty('--rgf-sidebar-width',value+'px');
    handle.setAttribute('aria-valuenow',String(value));
    return value;
  }
  let remembered=300;
  try{remembered=Number(localStorage.getItem('rgf_sidebar_width'))||300;}catch(_e){}
  setWidth(remembered);
  handle.addEventListener('pointerdown',function(event){
    if(event.button!==0)return;
    event.preventDefault();
    handle.setPointerCapture(event.pointerId);
    document.body.classList.add('sidebar-dragging');
  });
  handle.addEventListener('pointermove',function(event){
    if(!handle.hasPointerCapture(event.pointerId))return;
    setWidth(event.clientX-shell.getBoundingClientRect().left);
  });
  function stopDrag(event){
    document.body.classList.remove('sidebar-dragging');
    if(handle.hasPointerCapture(event.pointerId))handle.releasePointerCapture(event.pointerId);
    try{localStorage.setItem('rgf_sidebar_width',handle.getAttribute('aria-valuenow'));}catch(_e){}
  }
  handle.addEventListener('pointerup',stopDrag);
  handle.addEventListener('pointercancel',stopDrag);
  handle.addEventListener('keydown',function(event){
    if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight')return;
    event.preventDefault();
    const value=setWidth(Number(handle.getAttribute('aria-valuenow'))+(event.key==='ArrowRight'?20:-20));
    try{localStorage.setItem('rgf_sidebar_width',String(value));}catch(_e){}
  });
  window.addEventListener('resize',()=>setWidth(Number(handle.getAttribute('aria-valuenow'))));
})();
</script>
<script>
document.addEventListener('keydown',function(event){
  if(event.key==='Escape'){
    const menu=event.target.closest('.run-actions');
    if(menu){menu.open=false;menu.querySelector('summary').focus();event.preventDefault();}
  }
});
</script>
</body></html>
