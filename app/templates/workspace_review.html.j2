{% macro idea_management(idea) %}
<details class="run-actions"><summary role="button" aria-label="아이디어 {{ idea.lead_id }} 관리">⋯</summary>
<div class="management-menu" popover="manual">
<details><summary>✎ 이름 변경</summary><form method="post" action="/ideas/{{ idea.id }}/rename"><label>아이디어 제목<input name="title" value="{{ idea.title }}" required maxlength="500"></label><button type="submit">이름 저장</button></form></details>
<form method="post" action="/ideas/{{ idea.id }}/delete" onsubmit="return confirm('이 아이디어를 삭제하시겠습니까? 연결된 기자 검토 기록과 원문 근거 링크가 작업 목록에서 사라집니다. 원본 AI 분석 JSON과 다른 아이디어는 유지됩니다.');"><button type="submit" name="confirmed" value="yes">삭제</button></form>
</div></details>
{% endmacro %}
<!doctype html>
<html lang="ko">
<head>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>취재 아이디어 | RGF</title>
  <style>
    :root{font-family:system-ui,-apple-system,"Malgun Gothic",sans-serif;color:#2b2521;background:#f7f1eb;font-synthesis:none}
    *{box-sizing:border-box} body{margin:0} button,input,select,textarea{font:inherit} a{color:inherit;text-decoration:none}
    button{cursor:pointer} button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #f6a168;outline-offset:2px}
    .shell{display:grid;grid-template-columns:244px minmax(0,1fr);min-height:100vh}
    .sidebar{background:#fffcf9;border-right:1px solid #e7dcd3;padding:25px 18px;display:flex;flex-direction:column;gap:28px}
    .brand{display:flex;align-items:center;gap:12px;font-size:26px;font-weight:850;letter-spacing:-1px}
    .logo{display:grid;place-items:center;width:42px;height:42px;background:#e76929;color:white;border-radius:11px;font-weight:850}
    .brand small{display:block;font-size:9px;font-weight:700;letter-spacing:1.1px;color:#8c796b}
    .new{background:#e76b2b;color:#fff;text-align:center;padding:13px 10px;border-radius:9px;font-weight:750}
    .nav-title,.eyebrow{font-size:10px;font-weight:850;letter-spacing:1.6px;color:#b75b2f}
    .nav-title{color:#8f7e74;margin:0 10px 10px}
    .nav a{display:block;padding:11px 13px;border-radius:9px;font-size:14px;margin-bottom:3px}
    .nav a.current{background:#fbe8db;color:#b7501b;font-weight:750}
    .muted{color:#82746a}.sidebar-foot{font-size:12px;color:#9b8879;margin-top:auto;border-top:1px solid #eadfd7;padding-top:18px}
    main{padding:30px clamp(18px,3vw,52px) 60px;min-width:0}
    .back{font-size:13px;color:#817166}.top h1{font-size:clamp(24px,2.6vw,34px);letter-spacing:-1.4px;margin:11px 0 7px}
    .meta{font-size:13px;color:#87766b}.page-tabs{border-bottom:1px solid #e4d8cd;display:flex;gap:26px;margin:29px 0 20px;padding-bottom:12px;flex-wrap:wrap}
    .page-tabs a{font-size:14px;padding:0 0 12px}.page-tabs a.current{font-weight:800;color:#c45419;border-bottom:3px solid #e76b2b;margin-bottom:-15px}
    .workspace{display:grid;grid-template-columns:minmax(265px,.84fr) minmax(0,1.36fr);gap:16px;align-items:start}
    .panel{background:#fff;border:1px solid #eee1d6;border-radius:14px;box-shadow:0 3px 12px #5c352509;padding:20px;min-width:0}
    .panel h2{font-size:20px;letter-spacing:-.7px;margin:0 0 6px}.subtitle{font-size:13px;color:#82746a;margin:0 0 19px}
    .filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
    .filter{border:1px solid #e6dacf;border-radius:7px;background:#fff;padding:8px 11px;font-size:12px;color:#514137}
    .filter.active{background:#e76b2b;color:white;border-color:#e76b2b}
    .idea-list{max-height:68vh;overflow:auto;padding-right:3px}.idea-button{width:100%;text-align:left;border:0;border-bottom:1px solid #eee2da;background:#fff;display:flex;align-items:start;gap:10px;padding:14px 9px;border-radius:7px;color:#332923}
    .idea-button[aria-selected="true"],.idea-button[aria-pressed="true"]{background:#fcebe0}.id-chip{font-size:12px;color:#b75b2f;background:#fff4ed;border-radius:6px;padding:5px 7px;font-weight:800;flex-shrink:0}
    .idea-text{flex:1;min-width:0}.idea-text strong{display:block;font-size:13px;line-height:1.5}.idea-text span{display:block;color:#88766c;font-size:11px;margin-top:3px}
    .status{font-size:11px;background:#f5f1ec;border-radius:999px;padding:5px 9px;color:#736255;white-space:nowrap}
    .detail[hidden],.idea-button[hidden]{display:none!important}
    .detail-head{display:flex;gap:13px;align-items:flex-start}.detail-head .id-chip{font-size:16px;color:white;background:#e76b2b;padding:10px}
    .detail-head h2{font-size:clamp(19px,2vw,25px);line-height:1.35;margin:5px 0 9px}
    .detail-head .status{margin-left:auto}.summary{font-size:14px;line-height:1.8;color:#6d5d53;margin:17px 0 23px}
    .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.info-card{border:1px solid #eadbd0;border-radius:10px;padding:17px;background:#fffdfb}
    .info-card h3{color:#b9541e;font-size:14px;margin:0 0 11px}.info-card p{font-size:13px;line-height:1.8;margin:0;overflow-wrap:anywhere}
    .info-card ul{padding-left:19px;margin:0;font-size:13px;line-height:1.8}.info-card li+li{margin-top:7px}
    .evidence{margin-top:15px;background:#fcf1e8;border-radius:10px;padding:17px}.evidence h3{color:#a64d20;font-size:14px;margin:0 0 12px}
    .quote{background:#fff9f4;border:1px solid #eddfd4;padding:12px;border-radius:7px;margin-top:10px;font-size:13px;line-height:1.7;overflow-wrap:anywhere}
    .evidence summary{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;list-style:none;font-size:14px;font-weight:750;color:#a64d20}
    .evidence summary::-webkit-details-marker{display:none}
    .evidence summary::after{content:"⌄";font-size:19px;line-height:1;transition:transform .2s}
    .evidence[open] summary::after{transform:rotate(180deg)}
    .evidence-toggle-label{font-size:11px;font-weight:500;color:#8d5d43;margin-left:auto}
    .evidence-body{padding-top:8px}
    .evidence-label{font-size:11px;font-weight:700;color:#927e71;margin-bottom:4px}
    .evidence-context{line-height:1.75;color:#382c24;white-space:normal;overflow-wrap:anywhere}
    .quote small{display:block;color:#927e71;margin:0 0 6px}.warning{font-size:12px;color:#8d5d43;line-height:1.7;margin:12px 0 0}
    .review-form{margin-top:18px;border-top:1px solid #ebdfd5;padding-top:20px}.review-form h3{font-size:17px;margin:0 0 15px}
    .fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.review-form label{font-size:13px;font-weight:650;display:block;margin-bottom:12px}
    .review-form input,.review-form select,.review-form textarea{display:block;width:100%;border:1px solid #ddcec2;border-radius:7px;background:#fff;padding:10px;margin-top:7px;font-weight:400;color:#29221e}
    .review-form textarea{min-height:88px;resize:vertical}.save{background:#e76b2b;color:white;border:0;border-radius:7px;padding:11px 20px;font-weight:750}
    .empty{padding:35px 10px;color:#807269;font-size:14px;line-height:1.7}.help{font-size:12px;color:#8f7d72}
    @media(max-width:1080px){.shell{grid-template-columns:200px minmax(0,1fr)}.workspace{grid-template-columns:1fr}.idea-list{max-height:290px}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:650px){.shell{display:block}.sidebar{padding:12px 16px;gap:12px}.sidebar .nav,.sidebar-foot{display:none}.brand{font-size:21px}.new{padding:9px}.top h1{font-size:24px}main{padding:20px 14px}.page-tabs{gap:15px}.cards,.fields{grid-template-columns:1fr}.detail-head{flex-wrap:wrap}}

    .sidebar{gap:20px;position:sticky;top:0;height:100vh;overflow-y:auto}
    .sidebar .nav a{font-size:13px}
    .lead-group{margin:0 0 8px}
    .lead-group>summary{cursor:pointer;list-style:none;padding:11px 13px;border-radius:9px;font-size:14px;font-weight:750;color:#b7501b;background:#fbe8db;display:flex;gap:8px;align-items:center}
    .lead-group>summary::-webkit-details-marker{display:none}
    .lead-group>summary::before{content:'▸';font-size:13px}
    .lead-group[open]>summary::before{content:'▾'}
    .lead-count{margin-left:auto;font-size:12px;color:#9a654a}
    .lead-menu{margin:8px 0 0 9px;padding-left:9px;border-left:1px solid #eadbd0;display:grid;gap:3px}
    .nav .lead-menu a{display:block;margin:0;padding:9px 8px;font-size:12px;line-height:1.45;overflow-wrap:anywhere}
    .nav .lead-menu a.selected{background:#fcebe0;color:#9f4116;font-weight:700}
    .lead-label{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .lead-status{font-size:10px;color:#8e7b6e;margin-left:5px}
    .lead-status.hold{color:#ae5a25}
    .workspace{display:block}
    .workspace>.panel{width:100%;max-width:1100px}
    @media(max-width:650px){.sidebar{position:static;height:auto;max-height:46vh;overflow-y:auto}.sidebar .nav{display:block}.sidebar-foot{display:none}.lead-menu{max-height:220px;overflow:auto}}
  
    /* Resizable left navigation and properly wrapping reporting-lead titles. */
    .shell{grid-template-columns:minmax(0,var(--rgf-sidebar-width,300px)) 7px minmax(0,1fr)}
    .sidebar{min-width:0;overflow-x:hidden}
    .nav,.lead-group,.lead-menu,.lead-link{min-width:0;max-width:100%}
    .lead-label{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere;word-break:keep-all;line-height:1.5}
    .nav .lead-menu a{white-space:normal;overflow-wrap:anywhere}
    .sidebar-resizer{cursor:col-resize;touch-action:none;background:#ede3d9;position:relative}
    .sidebar-resizer::after{content:"";position:absolute;top:45%;left:2px;width:3px;height:38px;background:#c7b6a7;border-radius:4px}
    .sidebar-resizer:hover,.sidebar-resizer:focus-visible{background:#e7b392;outline:none}
    body.sidebar-dragging{cursor:col-resize;user-select:none}
    @media(max-width:650px){.shell{display:block}.sidebar-resizer{display:none}}

    .workspace{display:grid;grid-template-columns:minmax(230px,.8fr) minmax(0,1.45fr);gap:16px;align-items:start}
    .workspace>.panel{width:auto;max-width:none;min-width:0}
    .idea-button{min-width:0;overflow-wrap:anywhere}
    .idea-text strong{white-space:normal;overflow-wrap:anywhere;word-break:keep-all}
    .idea-button .status{flex-shrink:0}
    @media(max-width:1150px){.workspace{grid-template-columns:1fr}.idea-list{max-height:300px}}
    .info-card p,.info-card li{white-space:pre-wrap;overflow-wrap:anywhere}
    .key-point{margin:17px 0 14px;border-left:4px solid #e76b2b}
    .priority{display:inline-block;border:1px solid currentColor;border-radius:6px;padding:3px 7px;font-size:12px;font-weight:750}
    .priority-A{color:#a13d17;background:#fff0e5}.priority-B{color:#775414;background:#fff9df}.priority-C{color:#48616d;background:#edf5f8}
    .saved-run{display:flex;align-items:flex-start;gap:4px;min-width:0}.saved-run>.analysis-link{flex:1;min-width:0}
    .run-actions{flex:0 0 auto}.run-actions>summary{cursor:pointer;padding:9px;list-style:none}.run-actions>summary::-webkit-details-marker{display:none}
    .run-actions[open]{flex:1;min-width:0}.run-actions form{padding:8px 0;font-size:12px}.run-actions input{width:100%;min-width:0;margin:6px 0}.run-actions button{font:inherit;margin:4px 0}.run-actions small{display:block;line-height:1.5;color:#82746a}
    .managed-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:4px;position:relative;min-width:0;border-radius:8px;padding:4px}
    .managed-row>a,.managed-row>.idea-button{flex:1;min-width:0;margin:0;background:transparent;border:0}
    .managed-row:hover,.managed-row:focus-within{background:#f3e1d3}
    .managed-row:has(>a.selected),.managed-row:has(>.idea-button[aria-pressed="true"]){background:#fcebe0;box-shadow:inset 3px 0 #c45419}
    .managed-row[hidden]{display:none!important}
    .managed-row>.run-actions{flex:0 0 36px}
    .managed-row>.run-actions>summary{opacity:0;cursor:pointer;list-style:none;padding:8px;text-align:center;border-radius:6px}
    .managed-row:hover>.run-actions>summary,.managed-row:focus-within>.run-actions>summary,.managed-row>.run-actions[open]>summary{opacity:1}
    .managed-row>.run-actions[open]{flex:0 0 36px;min-width:0}
    .management-menu{position:absolute;inset:auto;width:184px;max-width:calc(100vw - 16px);margin:0;background:#fffcf9;color:#514137;border:0;border-radius:10px;padding:5px;box-shadow:0 5px 22px #5c352526;font-size:13px;z-index:1000}
    .management-menu:has(details[open]){width:240px}
    .management-menu summary{cursor:pointer;list-style:none}
    .management-menu summary::marker,.run-actions>summary::marker{content:""}
    .management-menu summary::-webkit-details-marker,.run-actions>summary::-webkit-details-marker{display:none}
    .management-menu>details>summary,.management-menu>form>button{display:block;width:100%;text-align:left;padding:9px 11px;margin:0;border:0;border-radius:6px;background:transparent;font:inherit;line-height:1.5}
    .management-menu>form>button{color:#b43b32}
    .management-menu>details>summary:hover,.management-menu>form>button:hover{background:#fbe8db}
    .management-menu summary:focus-visible,.management-menu button:focus-visible{outline:2px solid #e76b2b;outline-offset:-2px}
    .management-menu form{padding:0;margin:0}.management-menu details form{padding:8px 10px}
    .management-menu input{width:100%;min-width:0;margin:6px 0;padding:8px;border:1px solid #ddcec2;border-radius:6px;background:#fff;color:#2b2521}
    .management-menu details button{border:0;border-radius:6px;background:#e76b2b;color:#fff;padding:7px 11px;font:inherit}
    .management-menu small{display:block;line-height:1.5;color:#82746a}
    @media(hover:none),(pointer:coarse),(max-width:650px){.managed-row>.run-actions>summary{opacity:1}}
</style>
</head>
<body>
<div class="shell">
  <aside class="sidebar" aria-label="기본 탐색">
    <div class="brand"><span class="logo" aria-hidden="true" style="background:transparent url('/static/favicon.svg') center/contain no-repeat"></span><div>RGF<small>REPORTING GAP FINDER</small></div></div>
    <a href="/" class="new">＋ 새 자료 분석</a>
    <nav class="nav" aria-label="작업 메뉴">
      <p class="nav-title">WORKSPACE</p>
      <details class="lead-group" open>
        <summary>보도자료</summary>
        <div class="lead-menu" aria-label="저장된 완료 분석">
          {% for saved in completed_analyses %}
          <div class="saved-run managed-row">
          <a class="analysis-link{{ ' selected' if saved.run_id == run_id else '' }}" href="/workspace/{{ saved.run_id }}"{% if saved.run_id == run_id %} aria-current="true"{% endif %}>
            <span class="lead-label">{{ saved.title }}</span>
            <span class="lead-status">분석 #{{ saved.run_id }} · {{ saved.completed_at.strftime('%Y.%m.%d') if saved.completed_at else '완료일 미확인' }}</span>
          </a>
          <details class="run-actions"><summary role="button" aria-label="분석 #{{ saved.run_id }} 관리">⋯</summary>
            <div class="management-menu" popover="manual"><details><summary>✎ 이름 변경</summary>
            <form method="post" action="/analysis-runs/{{ saved.run_id }}/rename">
              <label>이름 변경<input name="title" value="{{ saved.title }}" required maxlength="500" aria-label="보도자료 제목"></label>
              <small>같은 보도자료의 모든 분석에 제목 변경이 적용됩니다.</small><button type="submit">이름 저장</button>
            </form></details>
            <form method="post" action="/analysis-runs/{{ saved.run_id }}/delete" onsubmit="return confirm('분석 #{{ saved.run_id }}을 삭제하시겠습니까? 연결된 취재 아이디어와 기자 검토 기록도 삭제됩니다. 다른 분석과 PDF 파일은 유지됩니다.');">
              <button type="submit" name="confirmed" value="yes">삭제</button>
            </form>
          </div></details></div>
          {% else %}<span class="muted">완료된 분석이 없습니다.</span>{% endfor %}
        </div>
      </details>
      <a href="/workspace/{{ run_id }}">▦ 분석 개요</a>
      <details class="lead-group" open>
        <summary>◉ 취재 아이디어 <span class="lead-count">{{ ideas|length }}</span></summary>
        <div class="lead-menu" aria-label="추가 취재 과제">
          {% for idea in ideas %}
          <div class="managed-row">
          <a class="lead-link" href="/review?run_id={{ run_id }}&amp;lead={{ idea.lead_id|urlencode }}" data-lead="{{ idea.lead_id }}" aria-controls="detail-{{ idea.id }}">
            <span class="lead-label">{{ idea.title }}</span>
            <span class="lead-status{{ ' hold' if idea.review_status == '보류' else '' }}">{{ idea.review_status }}</span>
          </a>
          {{ idea_management(idea) }}</div>
          {% else %}<span class="muted">등록된 취재 아이디어 없음</span>{% endfor %}
        </div>
      </details>
    </nav>
    <div class="sidebar-foot">RGF v0.1<br>AI 분석 결과는 취재 제안이며 최종 판단은 기자가 수행합니다.</div>
  </aside>
  <div class="sidebar-resizer" role="separator" aria-label="사이드바 너비 조절" aria-orientation="vertical" aria-valuemin="220" aria-valuemax="520" aria-valuenow="300" tabindex="0" title="좌우로 드래그하여 사이드바 너비 조절"></div>

  <main>
    <header class="top">
      <a href="/" class="back">← 새 자료 분석</a>
      <div class="eyebrow" style="margin-top:18px">REPORTING WORKSPACE</div>
      <h1>{{ source.title }}</h1>
      <div class="meta">{{ source.organization or "발표 기관 미입력" }} · 분석 #{{ run_id }} · 취재 아이디어 {{ ideas|length }}건</div>
    </header>
    <div class="workspace">
      <section class="panel" aria-label="취재 아이디어 목록">
        <h2>취재 아이디어 목록</h2>
        <p class="subtitle">추가 취재 과제 {{ ideas|length }}건 · 항목을 선택하면 오른쪽에 표시됩니다.</p>
        <div class="filters" role="group" aria-label="검토 상태 필터">
          <button type="button" class="filter active" data-filter="all" aria-pressed="true">전체 {{ ideas|length }}</button>
          {% for st in ['검토대기','승인','보류'] %}<button type="button" class="filter" data-filter="{{ st }}" aria-pressed="false">{{ st }} {{ ideas|selectattr('review_status','equalto',st)|list|length }}</button>{% endfor %}
        </div>
        <div class="idea-list" aria-label="아이디어 선택" id="idea-list">
          {% for idea in ideas %}
          <div class="managed-row">
          <button type="button" class="idea-button" data-lead="{{ idea.lead_id }}" data-status="{{ idea.review_status }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">
            <span class="idea-text"><strong>{{ idea.title }}</strong></span>
            <span class="status">{{ idea.review_status }}</span>
          </button>
          {{ idea_management(idea) }}</div>
          {% else %}<div class="empty">저장된 취재 아이디어가 없습니다.</div>{% endfor %}
        </div>
        <p class="help" id="filter-empty" hidden>해당 상태의 아이디어가 없습니다.</p>
      </section>
      <section class="panel" aria-label="선택한 취재 아이디어 상세" id="details">
        {% for idea in ideas %}
        <article class="detail" id="detail-{{ idea.id }}" data-detail-id="{{ idea.id }}" {% if not loop.first %}hidden{% endif %}>
          <div class="detail-head">
            <span class="id-chip">{{ idea.lead_id }}</span>
            <div><div class="priority priority-{{ idea.priority }}">우선순위 {{ idea.priority }} · {{ {'A':'핵심 변화·책임 확인','B':'중요한 보완 취재','C':'후속 확인·맥락'}.get(idea.priority, '') }}</div><h2>{{ idea.title }}</h2></div>
            <span class="status">{{ idea.review_status }}</span>
          </div>
          <section class="info-card key-point"><h3>◎ 핵심 취재 포인트</h3><p>{{ idea.angle }}</p></section>
          <div class="cards">
            <section class="info-card"><h3>◇ 취재 가치</h3><p>{{ idea.why_it_matters }}</p></section>
            <section class="info-card"><h3>？ 추가 취재 질문</h3>
              {% if idea.get('reporting_question') %}<p>{{ idea.reporting_question }}</p>
              {% else %}<p class="muted">저장된 취재 질문을 확인할 수 없습니다.</p>{% endif %}
            </section>
            <section class="info-card"><h3>▤ 확인해야 할 자료·증거</h3>
              {% if idea.get('evidence_needed') %}<ul>{% for item in idea.evidence_needed %}<li>{{ item }}</li>{% endfor %}</ul>
              {% else %}<p class="muted">저장된 추가 증거 항목을 확인할 수 없습니다.</p>{% endif %}
            </section>
          </div>
          <details class="evidence" aria-label="원문 근거">
            <summary>▤ 연결된 원문 근거 {{ evidence[idea.id]|length }}건 <span class="evidence-toggle-label">클릭하여 {{ '확인' if evidence[idea.id] else '안내 보기' }}</span></summary>
            <div class="evidence-body">
            {% if evidence[idea.id] %}
              {% for item in evidence[idea.id] %}
              <div class="quote"><small>{{ item.location_label }} · 원문 일치 확인 · {{ "문맥 자료" if item.relation_type == "CONTEXT" else item.relation_type }}</small>
                {% if item.source_context %}
                <div class="evidence-label">원문 주변 문맥</div>
                <div class="evidence-context">{{ item.source_context }}</div>
                <div class="evidence-label" style="margin-top:11px">일치 확인된 인용 구절</div>
                <strong>{{ item.content }}</strong>
                {% else %}
                <div class="evidence-label">연결된 인용 구절</div>{{ item.content }}
                <small style="margin-top:9px">원문에서 주변 문맥을 찾지 못했습니다. 출처 페이지를 다시 확인하세요.</small>
                {% endif %}
              </div>
              {% endfor %}
              <p class="warning">※ CONTEXT는 원문 문구가 일치한다는 의미입니다. 이 인용이 취재 아이디어를 실제로 뒷받침하는지는 검증되지 않았습니다.</p>
            {% else %}
              <p class="warning">아직 DB에 연결된 원문 근거가 없습니다. 근거가 확인된 것으로 간주하지 마세요.</p>
            {% endif %}
            </div>
          </details>
          <form class="review-form" method="post" action="/review" id="review-area-{{ idea.id }}">
            <h3>기자 검토 및 저장</h3>
            <input type="hidden" name="run_id" value="{{ run_id }}"><input type="hidden" name="lead_id" value="{{ idea.lead_id }}">
            <div class="fields">
              <label>기자 이름<input name="reviewer" maxlength="255" required value="{{ idea.reviewer or '' }}" autocomplete="name"></label>
              <label>검토 상태<select name="status" required>{% for status in ['검토대기','승인','보류'] %}<option value="{{ status }}" {% if status == idea.review_status %}selected{% endif %}>{{ status }}</option>{% endfor %}</select></label>
            </div>
            <label>검토 메모<textarea name="review_note" rows="3" placeholder="승인 근거 또는 보류 사유를 기록하세요.">{{ idea.review_note or '' }}</textarea></label>
            <p class="help">보류할 때는 사유를 반드시 입력해야 합니다.</p>
            <button type="submit" class="save">검토 결과 저장</button>
          </form>
        </article>
        {% else %}
        <div class="empty">선택할 아이디어가 없습니다. 다른 분석 결과를 확인하거나 새 자료를 분석하세요.</div>
        {% endfor %}
      </section>
    </div>
  </main>
</div>
<script>
(function(){
  const links=[...document.querySelectorAll('.lead-link')];
  const details=[...document.querySelectorAll('.detail')];
  const buttons=[...document.querySelectorAll('.idea-button')];
  const filters=[...document.querySelectorAll('.filter')];
  let filter='all';
  function selectLead(lead, updateUrl){
    const found=links.find(a=>a.dataset.lead===lead);
    const selected=found||links[0];
    links.forEach(a=>{
      const active=a===selected;
      a.classList.toggle('selected',active);
      if(active)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current');
    });
    buttons.forEach(b=>b.setAttribute('aria-pressed',String(!!selected&&b.dataset.lead===selected.dataset.lead)));
    details.forEach(d=>{d.hidden=!(selected&&d.id===selected.getAttribute('aria-controls'));});
    if(updateUrl&&selected){
      const url=new URL(window.location.href);
      url.searchParams.set('lead',selected.dataset.lead);
      history.replaceState(null,'',url.pathname+url.search);
    }
    // Direct sidebar navigation must still reveal the selected main-list item.
    if(selected&&filter!=='all'){
      const match=buttons.find(b=>b.dataset.lead===selected.dataset.lead);
      if(match&&match.hidden)applyFilter('all');
    }
  }
  function applyFilter(value){
    filter=value;
    filters.forEach(b=>{const active=b.dataset.filter===value;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});
    buttons.forEach(b=>{b.hidden=value!=='all'&&b.dataset.status!==value;b.closest('.managed-row').hidden=b.hidden;});
    document.getElementById('filter-empty').hidden=buttons.some(b=>!b.hidden);
    const active=buttons.find(b=>b.getAttribute('aria-pressed')==='true'&&!b.hidden);
    const first=buttons.find(b=>!b.hidden);
    if(!active&&first)selectLead(first.dataset.lead,true);
    if(!first)details.forEach(d=>d.hidden=true);
  }
  links.forEach(link=>link.addEventListener('click',event=>{
    if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
    event.preventDefault();selectLead(link.dataset.lead,true);
  }));
  buttons.forEach(button=>button.addEventListener('click',()=>selectLead(button.dataset.lead,true)));
  filters.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter)));
  const requested=new URLSearchParams(window.location.search).get('lead');
  selectLead(requested,false);
  window.addEventListener('popstate',()=>selectLead(new URLSearchParams(window.location.search).get('lead'),false));
  document.querySelectorAll('.review-form').forEach(form=>form.addEventListener('submit',event=>{
    const status=form.querySelector('[name="status"]').value;
    const note=form.querySelector('[name="review_note"]').value.trim();
    if(status==='보류'&&!note){event.preventDefault();alert('보류 사유를 입력해 주세요.');form.querySelector('[name="review_note"]').focus();}
  }));
})();
</script>

<script>
(function(){
  const shell=document.querySelector('.shell');
  const handle=document.querySelector('.sidebar-resizer');
  if(!shell||!handle)return;
  function bounds(){return {min:220,max:Math.max(220,Math.min(520,window.innerWidth-330))};}
  function setWidth(px){
    const {min,max}=bounds();
    const value=Math.min(max,Math.max(min,Math.round(px)));
    shell.style.setProperty('--rgf-sidebar-width',value+'px');
    handle.setAttribute('aria-valuenow',String(value));
    return value;
  }
  let remembered=300;
  try{remembered=Number(localStorage.getItem('rgf_sidebar_width'))||300;}catch(_e){}
  setWidth(remembered);
  handle.addEventListener('pointerdown',function(event){
    if(event.button!==0)return;
    event.preventDefault();
    handle.setPointerCapture(event.pointerId);
    document.body.classList.add('sidebar-dragging');
  });
  handle.addEventListener('pointermove',function(event){
    if(!handle.hasPointerCapture(event.pointerId))return;
    setWidth(event.clientX-shell.getBoundingClientRect().left);
  });
  function stopDrag(event){
    document.body.classList.remove('sidebar-dragging');
    if(handle.hasPointerCapture(event.pointerId))handle.releasePointerCapture(event.pointerId);
    try{localStorage.setItem('rgf_sidebar_width',handle.getAttribute('aria-valuenow'));}catch(_e){}
  }
  handle.addEventListener('pointerup',stopDrag);
  handle.addEventListener('pointercancel',stopDrag);
  handle.addEventListener('keydown',function(event){
    if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight')return;
    event.preventDefault();
    const value=setWidth(Number(handle.getAttribute('aria-valuenow'))+(event.key==='ArrowRight'?20:-20));
    try{localStorage.setItem('rgf_sidebar_width',String(value));}catch(_e){}
  });
  window.addEventListener('resize',()=>setWidth(Number(handle.getAttribute('aria-valuenow'))));
})();
</script>
<script>
(function(){
  const actions=[...document.querySelectorAll('.run-actions')];
  function close(action,restoreFocus){
    const panel=action.querySelector('.management-menu');
    if(panel.matches(':popover-open'))panel.hidePopover();
    action.open=false;
    panel.querySelectorAll('details[open]').forEach(item=>item.open=false);
    if(restoreFocus)action.querySelector('summary').focus({preventScroll:true});
  }
  function position(action){
    const panel=action.querySelector('.management-menu');
    const anchor=action.querySelector('summary').getBoundingClientRect();
    const box=panel.getBoundingClientRect();
    const left=Math.max(8,Math.min(anchor.right-box.width,window.innerWidth-box.width-8));
    const top=anchor.bottom+box.height+6<=window.innerHeight
      ? anchor.bottom+6 : Math.max(8,anchor.top-box.height-6);
    panel.style.left=(left+window.scrollX)+'px';
    panel.style.top=(top+window.scrollY)+'px';
  }
  actions.forEach(action=>{
    const panel=action.querySelector('.management-menu');
    action.addEventListener('toggle',event=>{
      if(event.target!==action)return;
      if(action.open){
        actions.filter(other=>other!==action&&other.open).forEach(other=>close(other,false));
        panel.showPopover();
        position(action);
        panel.querySelector('summary').focus({preventScroll:true});
      }else close(action,false);
    });
    panel.querySelector('details').addEventListener('toggle',event=>{
      if(!action.open)return;
      position(action);
      if(event.target.open)panel.querySelector('input').focus({preventScroll:true});
    });
  });
  document.addEventListener('click',event=>{
    actions.filter(action=>action.open&&!action.contains(event.target)).forEach(action=>close(action,false));
  });
  document.addEventListener('keydown',function(event){
    if(event.key==='Escape'){
      actions.filter(action=>action.open).forEach(action=>{close(action,true);event.preventDefault();});
    }
  });
  window.addEventListener('resize',()=>actions.filter(action=>action.open).forEach(action=>position(action)));
  document.addEventListener('scroll',event=>{
    actions.filter(action=>action.open&&!action.querySelector('.management-menu').contains(event.target))
      .forEach(action=>close(action,false));
  },true);
})();
</script>
</body>
</html>
